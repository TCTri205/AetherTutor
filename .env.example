# ==========================================
# App Settings & Environment
# ==========================================
PROJECT_NAME=AetherTutor
APP_ENV=development  # development | production | testing
DEBUG=false          # ⚠️ Luôn để False trong production

# ==========================================
# CORS & App URLs
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:8001
# URL cho Frontend gọi tới Backend API (Browser side)
VITE_API_URL=http://localhost:8001

# ==========================================
# Docker Networking — Host Configuration
# ==========================================
# LOCAL DEV (chạy không Docker):
#   DATABASE_HOST=localhost
#   REDIS_HOST=localhost
#   CHROMA_HOST=localhost
#
# DOCKER STACK (docker compose up):
#   DATABASE_HOST=db
#   REDIS_HOST=redis
#   CHROMA_HOST=chromadb
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ==========================================
# Database Credentials — Local Development
# ==========================================
# Dùng cho local dev (Python app kết nối trực tiếp)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aethertutor

# ==========================================
# Database Credentials — Docker Compose
# ==========================================
# Dùng bởi docker-compose.yml để khởi tạo PostgreSQL container
# ⚠️ Phải trùng với DB_USER/DB_PASSWORD/DB_NAME nếu muốn đồng bộ
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aethertutor

# ==========================================
# LLM Configuration
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_MODEL=hf.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Document Processing
# ==========================================
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf

# ==========================================
# Testing — LLM Mock Flag
# ==========================================
# true: Dùng mock LLM (nhanh, cho CI/CD)
# false: Dùng LLM thật (cho manual E2E, local dev)
USE_LLM_MOCK=false
