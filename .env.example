# ==========================================
# App Settings & Environment
# ==========================================
PROJECT_NAME=AetherTutor
APP_ENV=development  # development | production
DEBUG=True

# ==========================================
# CORS & App URLs
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8000

# ==========================================
# Docker Networking — Host Configuration
# ==========================================
# LOCAL DEV (chạy không Docker):
#   DATABASE_HOST=localhost
#   REDIS_HOST=localhost
#   CHROMA_HOST=localhost
#
# DOCKER STACK (docker compose up):
#   DATABASE_HOST=db
#   REDIS_HOST=redis
#   CHROMA_HOST=chromadb
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ==========================================
# Database Credentials
# ==========================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aethertutor

# ==========================================
# LLM Configuration
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_MODEL=hf.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M

# ==========================================
# Testing — LLM Mock Flag
# ==========================================
# true: Dùng mock LLM (nhanh, cho CI/CD)
# false: Dùng LLM thật (cho manual E2E, local dev)
USE_LLM_MOCK=false
